<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_floating_window"
    android:padding="4dp"
    android:elevation="8dp">

    <ImageButton
        android:id="@+id/btn_pause_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_media_pause"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"
        android:contentDescription="Pause/Play" />

    <ImageButton
        android:id="@+id/btn_slower"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_media_rew"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"
        android:contentDescription="Slower" />

    <ImageButton
        android:id="@+id/btn_faster"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_media_ff"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"
        android:contentDescription="Faster" />

    <ImageButton
        android:id="@+id/btn_split"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_crop"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="#4CAF50"
        android:contentDescription="Split/Stitch Now" />

    <ImageButton
        android:id="@+id/btn_exit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="#F44336"
        android:contentDescription="Exit" />
</LinearLayout>
